# ── FastAPI / Fly.io ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=spolysis
R2_PUBLIC_URL=https://your-bucket.r2.dev

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

TEMPORAL_HOST=your-temporal-host:7233
TEMPORAL_NAMESPACE=default

INTERNAL_API_SECRET=change-me-long-random-string
SENTRY_DSN_API=https://your-key@sentry.io/project-id

# ── Modal / Pipeline ────────────────────────────────────────────────────────
# Set these as Modal secrets, not env vars:
#   modal secret create spolysis-secrets \
#     R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... \
#     ANTHROPIC_API_KEY=... INTERNAL_API_URL=... INTERNAL_API_SECRET=... \
#     SENTRY_DSN_PIPELINE=...
ANTHROPIC_API_KEY=sk-ant-...
INTERNAL_API_URL=https://your-app.fly.dev

# ── Expo / React Native (prefix EXPO_PUBLIC_ for client-side) ───────────────
EXPO_PUBLIC_API_URL=https://your-app.fly.dev
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_RC_KEY_IOS=your-revenuecat-ios-api-key
EXPO_PUBLIC_RC_KEY_ANDROID=your-revenuecat-android-api-key
EXPO_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/project-id
