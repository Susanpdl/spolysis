# API and database. These server values must never enter the app bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Private R2 bucket, shared by API and Modal.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET_NAME=spolysis

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# API and continuous CPU workflow worker.
TEMPORAL_HOST=your-temporal-host:7233
TEMPORAL_NAMESPACE=your-namespace
TEMPORAL_API_KEY=your-temporal-api-key
TEMPORAL_TASK_QUEUE=tennis-analysis
INTERNAL_API_URL=https://your-app.fly.dev
INTERNAL_API_SECRET=replace-with-a-long-random-secret
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret
ALLOWED_ORIGINS=http://localhost:3000
SENTRY_DSN=

# Put only these public client values in app/.env.
EXPO_PUBLIC_API_URL=https://your-app.fly.dev
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
