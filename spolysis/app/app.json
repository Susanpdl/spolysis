{
  "expo": {
    "name": "Spolysis",
    "slug": "spolysis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spolysis.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Spolysis uses your camera to record your tennis strokes for analysis.",
        "NSMicrophoneUsageDescription": "Spolysis uses your microphone while recording tennis strokes.",
        "NSPhotoLibraryUsageDescription": "Spolysis lets you upload existing videos from your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.spolysis.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "react-native-vision-camera",
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "CAMERA",
            "MICROPHONE",
            "PHOTO_LIBRARY"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spolysis lets you upload existing videos from your photo library."
        }
      ]
    ],
    "scheme": "spolysis",
    "extra": {
      "eas": {
        "projectId": "417f03f4-f2b1-4aab-93ed-d02f02f97069"
      }
    },
    "owner": "susshann"
  }
}
